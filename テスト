<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>今日の運勢アプリ</title>
  <style>
    body { font-family: sans-serif; text-align: center; padding-top: 50px; background-color: #f4f4f9; }
    .card { background: white; padding: 30px; display: inline-block; border-radius: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
    button { padding: 10px 20px; font-size: 16px; cursor: pointer; background: #007bff; color: white; border: none; border-radius: 6px; }
    button:hover { background: #0056b3; }
    #result { margin-top: 20px; font-size: 24px; font-weight: bold; color: #333; }
  </style>
</head>
<body>
  <div class="card">
    <h1>🔮 今日の運勢 🔮</h1>
    <button onclick="drawOmikuji()">おみくじを引く</button>
    <div id="result">？</div>
  </div>

  <script>
    function drawOmikuji() {
      const results = ["大吉 🌟", "吉 😊", "中吉 👍", "小吉 ☘️", "末吉 💡", "凶 ☔"];
      const random = Math.floor(Math.random() * results.length);
      document.getElementById("result").textContent = results[random];
    }
  </script>
</body>
</html>
